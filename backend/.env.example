APP_ENV=development
TIMEZONE=Asia/Kuala_Lumpur
# Set a random secret before starting the API.
JWT_SECRET=replace-with-a-random-secret
# Optional local development database. Omit DATABASE_URL to use MySQL below.
# DATABASE_URL=sqlite:///./hr_admin_dev.sqlite3
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=hr_admin
DB_PASSWORD=replace-me
DB_NAME=nct_pmc_hr_admin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
# Seed reads this value; no password is hard-coded in the seeder.
SEED_DEFAULT_PASSWORD=choose-a-local-test-password
# Optional scheduled email reminders (see docs/WORKFLOWS.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
FRONTEND_URL=http://localhost:5173
